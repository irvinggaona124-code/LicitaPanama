# ==============================================================================
# LICITAPANAMA AI - VARIABLES DE ENTORNO
# ==============================================================================

# Google Gemini API (gemini-3.8-flash)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Auth, Postgres Database & Vector pgvector
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# URL Base de la Aplicación
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Bóveda Cifrada de Facturas DGI (Llave AES-256-GCM de 32 bytes en hex)
DGI_ENCRYPTION_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Notificaciones por Correo (Resend API)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=alertas@licitapanama.ai

# Notificaciones WhatsApp (Meta WhatsApp Cloud API - Plan $50)
WHATSAPP_CLOUD_API_TOKEN=your_meta_whatsapp_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id

# Webhooks & Billing (LemonSqueezy / Paddle / Yappy)
LEMONSQUEEZY_API_KEY=your_lemonsqueezy_key
LEMONSQUEEZY_WEBHOOK_SECRET=your_lemonsqueezy_webhook_secret

# Soporte Chat en Vivo (Crisp.chat - Exclusivo Plan $50)
NEXT_PUBLIC_CRISP_WEBSITE_ID=your_crisp_website_id

# Sincronización Cron PanamáCompra
CRON_SECRET=panamacompra_sync_secret_token_123
